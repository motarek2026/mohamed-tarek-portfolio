# Public URL of the deployed site (used for OpenGraph & metadataBase)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Enable local portfolio visual editor ("true" to show Edit mode controls, "false" for public production)
NEXT_PUBLIC_ENABLE_EDIT=false

# URL of the Portfolio Dashboard (for analytics beacon & public leads submission)
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3001

# Shared secret for on-demand ISR revalidation & preview mode
PORTFOLIO_REVALIDATE_SECRET=mt-portfolio-revalidate-secret-2026

# Supabase (Anon Key for public website read-only access)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
